cabal-version:      3.0
name:               Recipe-Manager
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Colin David Baechtold
maintainer:         colindavid.baechtold@uzh.ch
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
extra-source-files: examples/recipe.json, hie.yaml,
                    sql/*.sql, sql/recipes/*.sql, sql/menu_plans/*.sql,
                    sql/migrations/*.sql, sql/migration-tracking/*.sql

common warnings
    ghc-options: -Wall

executable Recipe-Manager
    import:           warnings
    main-is:          Main.hs
    other-modules: Api, Api.Recipes, Api.Foods, Api.FoodPlans, Domain.Recipe, Domain.Food, Domain.Units,
                   Domain.IngredientsFilter, Domain.MenuPlan,
                   Integration.Usda,
                   Storage.Database, Storage.Migrations, Storage.Recipes, Storage.MenuPlans, Storage.Sql,
                   Storage.Sql.Recipes, Storage.Sql.MenuPlans,
                   Storage.Sql.Migrations, Storage.Sql.Connection
    -- other-extensions:
    build-depends:    base ^>=4.18.3.0,
                      directory >=1.3 && <1.4,
                      filepath >=1.4 && <1.6,
                      aeson >=2.1 && <2.3,
                      bytestring >=0.11 && <0.13,
                      direct-sqlite >=2.3.29 && <2.4,
                      file-embed >=0.0.16 && <0.1,
                      http-client >=0.7 && <0.8,
                      http-client-tls >=0.3 && <0.4,
                      http-types >=0.12 && <0.13,
                      scotty >=0.30 && <0.31,
                      sqlite-simple >=0.4.19 && <0.5,
                      text >=2.0 && <2.2,
                      time >=1.12 && <1.15
    hs-source-dirs:   app, src
    ghc-options:      -threaded -rtsopts
    default-language: Haskell2010
